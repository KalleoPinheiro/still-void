{
  "name": "@still-void/ui",
  "version": "3.3.0",
  "description": "Still Void design system — React/Next.js design system with a server-safe entry and a client-only entry, built on shadcn/ui.",
  "license": "MIT",
  "author": "Kalleo Pinheiro",
  "keywords": [
    "design-system",
    "ui",
    "components",
    "react",
    "nextjs",
    "server-components",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KalleoPinheiro/still-void.git"
  },
  "bugs": {
    "url": "https://github.com/KalleoPinheiro/still-void/issues"
  },
  "homepage": "https://github.com/KalleoPinheiro/still-void#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.7",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./react/client": {
      "import": {
        "types": "./dist/react/client/index.d.ts",
        "default": "./dist/react/client/index.js"
      },
      "require": {
        "types": "./dist/react/client/index.d.cts",
        "default": "./dist/react/client/index.cjs"
      }
    },
    "./theme.css": "./dist/theme.css",
    "./style.css": "./dist/style.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./shadcn-overrides.css": "./dist/shadcn-overrides.css",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react/index.d.ts"
      ],
      "react/client": [
        "./dist/react/client/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && npm run build:css",
    "build:css": "node scripts/copy-css.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint:package": "publint --strict && attw --pack . --exclude-entrypoints theme.css style.css tailwind.css shadcn-overrides.css",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "npm run build && changeset publish",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=4"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@storybook/addon-a11y": "^10.5.2",
    "@storybook/addon-docs": "^10.5.2",
    "@storybook/react-vite": "^10.5.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "publint": "^0.3.22",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.18.0",
    "storybook": "^10.5.2",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.3.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-primitive": "^2.1.10",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  }
}
